{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bide",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "RECORDER", "class_name": "Recorder" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Recorder"] }],
  "triggers": { "crons": ["*/10 * * * *"] },
  "observability": { "enabled": true }
}
